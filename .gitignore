# .gitignore for Sentistock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/

# Data Files (个人数据，不提交)
/data/*.json
/data/memory_*.json
data/backtest_*.json

# Models (训练好的模型文件，较大)
/models/

# Output (生成的图表和报告，不提交)
/output/

# Environment Variables (包含密码！)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
