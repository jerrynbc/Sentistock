*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/

# Data Files (包含个人数据)
*.json
!package.json
memory_*.json
*_backtest_*.json

# Reports (个人分析报告)
*_分析报告_*.txt
*_report_*.txt

# Charts and Images (生成的图表)
*.png
!*.md

# Environment Variables (包含密码！)
.env
.env.local
.env.*.local

# Test files with credentials
test_jq.py
test_*.py
!test_template.py

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
